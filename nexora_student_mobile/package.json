{
  "name": "nexora_student_mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~56.0.17",
    "@expo/vector-icons": "^15.0.2",
    "@tanstack/react-query": "^5.101.0",
    "expo": "~56.0.16",
    "expo-constants": "~56.0.21",
    "expo-linking": "~56.0.15",
    "expo-router": "~56.2.15",
    "expo-secure-store": "^56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.85.3",
    "react-native-gesture-handler": "~2.31.1",
    "react-native-reanimated": "4.3.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "^4.25.2",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.8.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "^56.0.15",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "install:android": "bash ./scripts/install-android.sh",
    "install:ios": "bash ./scripts/install-ios.sh",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "maestro:student:exams": "maestro test -e MAESTRO_APP_ID=com.anonymous.nexorastudentmobile .maestro/student-login-and-exams.yaml",
    "maestro:student:exams-detail": "maestro test -e MAESTRO_APP_ID=com.anonymous.nexorastudentmobile .maestro/student-exams-filters-and-detail.yaml",
    "maestro:student:results": "maestro test -e MAESTRO_APP_ID=com.anonymous.nexorastudentmobile .maestro/student-results-and-summary.yaml",
    "maestro:student:results-timeline": "maestro test -e MAESTRO_APP_ID=com.anonymous.nexorastudentmobile .maestro/student-results-timeline-summary.yaml",
    "maestro:student:review": "maestro test -e MAESTRO_APP_ID=com.anonymous.nexorastudentmobile .maestro/student-review-journey.yaml",
    "maestro:student:review-pagination": "maestro test -e MAESTRO_APP_ID=com.anonymous.nexorastudentmobile .maestro/student-review-filters-and-pagination.yaml",
    "maestro:student:attempt": "maestro test -e MAESTRO_APP_ID=com.anonymous.nexorastudentmobile .maestro/student-active-attempt.yaml",
    "maestro:student:analytics": "maestro test -e MAESTRO_APP_ID=com.anonymous.nexorastudentmobile .maestro/student-analytics-and-logout.yaml",
    "maestro:student:offline-login": "maestro test -e MAESTRO_APP_ID=com.anonymous.nexorastudentmobile .maestro/student-login-offline-error.yaml",
    "maestro:student:offline-register": "maestro test -e MAESTRO_APP_ID=com.anonymous.nexorastudentmobile .maestro/student-register-offline-setup-error.yaml",
    "maestro:student:all": "npm run maestro:student:exams && npm run maestro:student:exams-detail && npm run maestro:student:results && npm run maestro:student:results-timeline && npm run maestro:student:review && npm run maestro:student:review-pagination && npm run maestro:student:attempt && npm run maestro:student:analytics"
  },
  "private": true
}
