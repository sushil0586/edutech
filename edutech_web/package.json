{
  "name": "edutech_web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "verify:student": "npm run typecheck && npm run build",
    "test:e2e": "playwright test",
    "test:e2e:baseline": "playwright test --grep-invert @mutable",
    "test:e2e:mobile-web": "playwright test tests/e2e/workflow/student-mobile-sanity-workspace.spec.ts tests/e2e/workflow/student-family-mobile-sanity.spec.ts tests/e2e/workflow/student-family-mobile-results-sanity.spec.ts tests/e2e/workflow/student-mobile-state-panel-sanity.spec.ts",
    "test:e2e:operator-mobile-pack": "playwright test tests/e2e/workflow/operator-mobile-shell-sanity.spec.ts tests/e2e/workflow/admin-mobile-economy-workflow.spec.ts tests/e2e/workflow/admin-mobile-people-workflow.spec.ts tests/e2e/workflow/admin-mobile-security-workflow.spec.ts tests/e2e/workflow/admin-mobile-reports-workflow.spec.ts tests/e2e/workflow/teacher-mobile-question-bank-workflow.spec.ts tests/e2e/workflow/teacher-mobile-reviews-workflow.spec.ts tests/e2e/workflow/teacher-mobile-authoring-workflow.spec.ts tests/e2e/workflow/institute-mobile-question-bank-workflow.spec.ts tests/e2e/workflow/institute-mobile-reviews-workflow.spec.ts tests/e2e/workflow/institute-mobile-exams-workflow.spec.ts --project=chromium",
    "test:e2e:operator-mobile-pack:repeat": "playwright test tests/e2e/workflow/operator-mobile-shell-sanity.spec.ts tests/e2e/workflow/admin-mobile-economy-workflow.spec.ts tests/e2e/workflow/admin-mobile-people-workflow.spec.ts tests/e2e/workflow/admin-mobile-security-workflow.spec.ts tests/e2e/workflow/admin-mobile-reports-workflow.spec.ts tests/e2e/workflow/teacher-mobile-question-bank-workflow.spec.ts tests/e2e/workflow/teacher-mobile-reviews-workflow.spec.ts tests/e2e/workflow/teacher-mobile-authoring-workflow.spec.ts tests/e2e/workflow/institute-mobile-question-bank-workflow.spec.ts tests/e2e/workflow/institute-mobile-reviews-workflow.spec.ts tests/e2e/workflow/institute-mobile-exams-workflow.spec.ts --project=chromium --repeat-each=2",
    "test:e2e:operator-mobile-pack:cross-browser-repeat": "PLAYWRIGHT_ENABLE_CROSS_BROWSER=1 playwright test tests/e2e/workflow/operator-mobile-shell-sanity.spec.ts tests/e2e/workflow/admin-mobile-economy-workflow.spec.ts tests/e2e/workflow/admin-mobile-people-workflow.spec.ts tests/e2e/workflow/admin-mobile-security-workflow.spec.ts tests/e2e/workflow/admin-mobile-reports-workflow.spec.ts tests/e2e/workflow/teacher-mobile-question-bank-workflow.spec.ts tests/e2e/workflow/teacher-mobile-reviews-workflow.spec.ts tests/e2e/workflow/teacher-mobile-authoring-workflow.spec.ts tests/e2e/workflow/institute-mobile-question-bank-workflow.spec.ts tests/e2e/workflow/institute-mobile-reviews-workflow.spec.ts tests/e2e/workflow/institute-mobile-exams-workflow.spec.ts --project=firefox --project=webkit --repeat-each=2",
    "test:e2e:mutable": "PLAYWRIGHT_REAL_DATA_MODE=1 playwright test --grep @mutable",
    "test:e2e:mutable:subscription-request": "../edutech_backend/.venv/bin/python ../edutech_backend/manage.py reset_demo_institute_subscription_workflow --target-institute-code DLI001 && PLAYWRIGHT_ENABLE_MUTABLE_INSTITUTE_SUBSCRIPTION_REQUEST=1 playwright test tests/e2e/workflow/admin-institute-subscription-request.mutable.spec.ts --project=chromium",
    "test:e2e:mutable:shared-library-enforcement": "../edutech_backend/.venv/bin/python ../edutech_backend/manage.py seed_demo_shared_library_access --target-institute-code DLI001 && PLAYWRIGHT_ENABLE_MUTABLE_INSTITUTE_SHARED_LIBRARY_ENTITLEMENT_ENFORCEMENT=1 PLAYWRIGHT_ENABLE_MUTABLE_TEACHER_SHARED_LIBRARY_ENTITLEMENT_ENFORCEMENT=1 playwright test tests/e2e/workflow/institute-shared-library-entitlement-enforcement.mutable.spec.ts tests/e2e/workflow/teacher-shared-library-entitlement-enforcement.mutable.spec.ts --project=chromium",
    "test:e2e:mutable:shared-library-workflow": "../edutech_backend/.venv/bin/python ../edutech_backend/manage.py seed_demo_shared_library_access --target-institute-code DLI001 && PLAYWRIGHT_ENABLE_MUTABLE_INSTITUTE_SHARED_LIBRARY_QUOTA=1 PLAYWRIGHT_ENABLE_MUTABLE_TEACHER_SHARED_LIBRARY_QUOTA=1 npx playwright test tests/e2e/workflow/teacher-question-bank-shared-library-no-entitlement.spec.ts tests/e2e/workflow/institute-question-bank-shared-library-no-entitlement.spec.ts tests/e2e/workflow/teacher-question-bank-shared-library-quota-exhausted.mutable.spec.ts tests/e2e/workflow/institute-question-bank-shared-library-quota-exhausted.mutable.spec.ts --project=chromium && ../edutech_backend/.venv/bin/python ../edutech_backend/manage.py seed_demo_shared_library_access --target-institute-code DLI001 && PLAYWRIGHT_ENABLE_MUTABLE_INSTITUTE_SHARED_LIBRARY_BUILDER_FLOW=1 PLAYWRIGHT_ENABLE_MUTABLE_TEACHER_SHARED_LIBRARY_BUILDER_FLOW=1 npx playwright test tests/e2e/workflow/institute-shared-library-builder-flow.mutable.spec.ts tests/e2e/workflow/teacher-shared-library-builder-flow.mutable.spec.ts --project=chromium && ../edutech_backend/.venv/bin/python ../edutech_backend/manage.py seed_demo_shared_library_access --target-institute-code DLI001 && PLAYWRIGHT_ENABLE_MUTABLE_INSTITUTE_SHARED_LIBRARY_PUBLISH_READINESS=1 PLAYWRIGHT_ENABLE_MUTABLE_TEACHER_SHARED_LIBRARY_PUBLISH_READINESS=1 npx playwright test tests/e2e/workflow/institute-shared-library-publish-readiness.mutable.spec.ts tests/e2e/workflow/teacher-shared-library-publish-readiness.mutable.spec.ts --project=chromium && ../edutech_backend/.venv/bin/python ../edutech_backend/manage.py seed_demo_shared_library_access --target-institute-code DLI001 && PLAYWRIGHT_ENABLE_MUTABLE_INSTITUTE_SHARED_LIBRARY_LINK=1 npx playwright test tests/e2e/workflow/institute-question-bank-shared-library-link.mutable.spec.ts --project=chromium && ../edutech_backend/.venv/bin/python ../edutech_backend/manage.py seed_demo_shared_library_access --target-institute-code DLI001 && PLAYWRIGHT_ENABLE_MUTABLE_TEACHER_SHARED_LIBRARY_REQUEST=1 npx playwright test tests/e2e/workflow/teacher-question-bank-shared-library-request.mutable.spec.ts --project=chromium",
    "test:e2e:mutable:commercialization-bundle": "npm run test:e2e:mutable:subscription-request && npm run test:e2e:mutable:shared-library-enforcement",
    "test:e2e:full-round": "PLAYWRIGHT_REAL_DATA_MODE=1 playwright test",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e:release-smoke": "playwright test tests/e2e/workflow/student-dashboard-workspace.spec.ts tests/e2e/workflow/student-exam-detail-workspace.spec.ts tests/e2e/workflow/student-results-workspace.spec.ts tests/e2e/workflow/teacher-results-workspace.spec.ts tests/e2e/workflow/institute-dashboard-workspace.spec.ts tests/e2e/workflow/institute-question-bank-workspace.spec.ts tests/e2e/workflow/admin-dashboard-workspace.spec.ts tests/e2e/workflow/admin-economy-workspace.spec.ts --project=chromium",
    "test:e2e:stage-performance": "playwright test tests/e2e/workflow/student-results-timing.spec.ts tests/e2e/workflow/student-summary-timing.spec.ts tests/e2e/workflow/student-review-timing.spec.ts tests/e2e/workflow/teacher-results-timing.spec.ts tests/e2e/workflow/teacher-question-bank-timing.spec.ts tests/e2e/workflow/institute-results-timing.spec.ts tests/e2e/workflow/institute-shell-timing.spec.ts tests/e2e/workflow/institute-question-bank-timing.spec.ts tests/e2e/workflow/admin-economy-timing.spec.ts tests/e2e/workflow/admin-reports-timing.spec.ts tests/e2e/workflow/admin-institutes-timing.spec.ts tests/e2e/workflow/admin-people-timing.spec.ts tests/e2e/workflow/admin-security-timing.spec.ts tests/e2e/workflow/admin-settings-timing.spec.ts --project=chromium",
    "test:e2e:deep-workflow": "playwright test tests/e2e/workflow/institute-family-release-happy-path.mutable.spec.ts tests/e2e/workflow/teacher-family-release-happy-path.mutable.spec.ts tests/e2e/workflow/institute-family-release-state.mutable.spec.ts tests/e2e/workflow/institute-family-immediate-release.mutable.spec.ts tests/e2e/workflow/admin-mixed-institute-onboarding.mutable.spec.ts tests/e2e/workflow/student-results-storytelling.mutable.spec.ts tests/e2e/workflow/institute-results-live-populated.mutable.spec.ts tests/e2e/workflow/teacher-results-live-populated.mutable.spec.ts tests/e2e/workflow/institute-results-analysis-populated.mutable.spec.ts tests/e2e/workflow/teacher-results-analysis-populated.mutable.spec.ts tests/e2e/workflow/admin-economy-mutable.spec.ts tests/e2e/workflow/admin-economy-cross-role-package-propagation.mutable.spec.ts --project=chromium",
    "test:e2e:advanced-builder-confidence": "playwright test tests/e2e/workflow/admin-advanced-builder-workspace.spec.ts tests/e2e/workflow/admin-exam-creation-advanced-matrix.mutable.spec.ts tests/e2e/workflow/admin-exam-creation-wizard-matrix.mutable.spec.ts tests/e2e/workflow/institute-exam-creation-advanced-matrix.mutable.spec.ts tests/e2e/workflow/institute-exam-creation-wizard-matrix.mutable.spec.ts tests/e2e/workflow/admin-exam-creation-advanced-student-attempt.mutable.spec.ts --project=chromium",
    "test:e2e:cross-browser": "PLAYWRIGHT_ENABLE_CROSS_BROWSER=1 playwright test tests/e2e/workflow/student-cross-browser-*.spec.ts tests/e2e/workflow/teacher-cross-browser-*.spec.ts tests/e2e/workflow/institute-cross-browser-*.spec.ts tests/e2e/workflow/admin-cross-browser-*.spec.ts",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:trace:student-exam-detail": "playwright test tests/e2e/workflow/student-exam-detail-workspace.spec.ts --project=chromium --trace on",
    "test:e2e:trace:student-attempt-flow": "playwright test tests/e2e/workflow/student-attempt-runtime-workspace.spec.ts tests/e2e/workflow/student-post-submit-workspace.spec.ts tests/e2e/workflow/student-review-workspace.spec.ts --project=chromium --trace on",
    "test:e2e:trace:student-phase3": "playwright test tests/e2e/workflow/student-exam-detail-workspace.spec.ts tests/e2e/workflow/student-attempt-runtime-workspace.spec.ts tests/e2e/workflow/student-post-submit-workspace.spec.ts tests/e2e/workflow/student-review-workspace.spec.ts --project=chromium --trace on",
    "test:e2e:timing:student-results": "playwright test tests/e2e/workflow/student-results-timing.spec.ts --project=chromium",
    "test:e2e:timing:student-summary": "playwright test tests/e2e/workflow/student-summary-timing.spec.ts --project=chromium",
    "test:e2e:timing:student-review": "playwright test tests/e2e/workflow/student-review-timing.spec.ts --project=chromium",
    "test:e2e:timing:institute-results": "playwright test tests/e2e/workflow/institute-results-timing.spec.ts --project=chromium",
    "test:e2e:timing:institute-shell": "playwright test tests/e2e/workflow/institute-shell-timing.spec.ts --project=chromium",
    "test:e2e:timing:institute-question-bank": "playwright test tests/e2e/workflow/institute-question-bank-timing.spec.ts --project=chromium",
    "test:e2e:timing:admin-reports": "playwright test tests/e2e/workflow/admin-reports-timing.spec.ts --project=chromium",
    "test:e2e:timing:admin-institutes": "playwright test tests/e2e/workflow/admin-institutes-timing.spec.ts --project=chromium",
    "test:e2e:timing:admin-people": "playwright test tests/e2e/workflow/admin-people-timing.spec.ts --project=chromium",
    "test:e2e:timing:admin-security": "playwright test tests/e2e/workflow/admin-security-timing.spec.ts --project=chromium",
    "test:e2e:timing:admin-settings": "playwright test tests/e2e/workflow/admin-settings-timing.spec.ts --project=chromium",
    "test:e2e:timing:teacher-results": "playwright test tests/e2e/workflow/teacher-results-timing.spec.ts --project=chromium",
    "test:e2e:timing:teacher-question-bank": "playwright test tests/e2e/workflow/teacher-question-bank-timing.spec.ts --project=chromium",
    "test:e2e:trace:institute-phase3": "playwright test tests/e2e/workflow/institute-dashboard-workspace.spec.ts tests/e2e/workflow/institute-exams-workspace.spec.ts tests/e2e/workflow/institute-exam-detail-workspace.spec.ts tests/e2e/workflow/institute-results-workspace.spec.ts tests/e2e/workflow/institute-reviews-workspace.spec.ts tests/e2e/workflow/institute-question-bank-workspace.spec.ts --project=chromium --trace on",
    "test:e2e:trace:teacher-phase3": "playwright test tests/e2e/workflow/teacher-cross-browser-shell.spec.ts tests/e2e/workflow/teacher-exam-detail-workspace.spec.ts tests/e2e/workflow/teacher-results-workspace.spec.ts tests/e2e/workflow/teacher-reviews-workspace.spec.ts tests/e2e/workflow/question-bank-deep.spec.ts tests/e2e/workflow/teacher-results-live-workspace.spec.ts tests/e2e/workflow/teacher-results-analysis-workspace.spec.ts --project=chromium --trace on"
  },
