#!/usr/bin/env bash
set -euo pipefail

project_root="/srv/saas/projects/learning-portal"
backup_root="/srv/saas/backups/learning-portal"

usage() {
  echo "usage: learning-portal-ops {status|logs|backup|releases|certificate}" >&2
  exit 2
}

case "${1:-}" in
  status)
    echo "Active release: $(cat "$project_root/.active-release.pending")"
    docker inspect learning-portal-backend-1 learning-portal-web-1 learning-portal-api-gateway-1 |
      jq -r '.[] | [.Name[1:], .State.Status, (.State.Health.Status // "none"), .RestartCount, .Image] | @tsv'
    systemctl show learning-portal-backup.service -p Result -p ExecMainStatus --no-pager
    systemctl is-active learning-portal-backup.timer
    curl -fsS -o /dev/null -w 'public_status=%{http_code} public_seconds=%{time_total}\n' https://learn.accerio.in/login
    ;;
  logs)
    docker logs --since "${2:-30m}" learning-portal-backend-1 2>&1
    docker logs --since "${2:-30m}" learning-portal-web-1 2>&1
    docker logs --since "${2:-30m}" learning-portal-api-gateway-1 2>&1
    ;;
  backup)
    systemctl start learning-portal-backup.service
    systemctl show learning-portal-backup.service -p Result -p ExecMainStatus --no-pager
    find "$backup_root" -mindepth 1 -maxdepth 1 -type d -name '20??????T??????Z' -printf '%f\n' | sort | tail -1
    ;;
  releases)
    active="$(cat "$project_root/.active-release.pending")"
    find "$project_root/releases" -mindepth 1 -maxdepth 1 -type d -printf '%p\n' | sort |
      while IFS= read -r release; do
        if [ "$release" = "$active" ]; then echo "ACTIVE $release"; else echo "      $release"; fi
      done
    ;;
  certificate)
    echo | openssl s_client -connect learn.accerio.in:443 -servername learn.accerio.in 2>/dev/null |
      openssl x509 -noout -subject -issuer -dates -fingerprint -sha256
    ;;
  *) usage ;;
esac

