[Unit]
Description=Record learning portal operational alert for %i

[Service]
Type=oneshot
User=root
Group=root
Environment=AWS_SHARED_CREDENTIALS_FILE=/srv/saas/secrets/learning-portal-alert/credentials
Environment=AWS_DEFAULT_REGION=ap-south-1
Environment=SNS_TOPIC_ARN=arn:aws:sns:ap-south-1:227022022984:learning-portal-operations
ExecStart=/usr/local/sbin/learning-portal-alert %i
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadOnlyPaths=/srv/saas/secrets/learning-portal-alert/credentials
ReadWritePaths=/srv/saas/projects/learning-portal/alerts
NoNewPrivileges=true
